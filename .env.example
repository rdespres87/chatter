# Chatter server environment configuration
# Copy this file to .env and adjust values as needed.

# Server bind address: 0.0.0.0 (all interfaces) or 127.0.0.1 (localhost only)
CHATTER_HOST=0.0.0.0

# Server listening port (default 8080)
CHATTER_PORT=12345

# Logging level: debug, info, warn, error
RUST_LOG=info

# SQLite database path (inside the container)
DB_PATH=/app/data/chatter.db
